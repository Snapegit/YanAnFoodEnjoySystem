<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.MeishipengrenDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.MeishipengrenEntity" id="meishipengrenMap">
        <result property="meishimingcheng" column="meishimingcheng"/>
        <result property="meishileixing" column="meishileixing"/>
        <result property="meishitupian" column="meishitupian"/>
        <result property="shicai" column="shicai"/>
        <result property="pengrenbuzhou" column="pengrenbuzhou"/>
        <result property="shipin" column="shipin"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.MeishipengrenView" >

		SELECT  meishipengren.* FROM meishipengren  meishipengren 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.MeishipengrenView" >
		SELECT * FROM meishipengren  meishipengren <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
